[bootstrap]
main_collection = /examples/quality_api_example.collectionc
render = /drp/drp.renderc

[script]
shared_state = 1

[display]
width = 960
height = 640
high_dpi = 1

[android]
input_method = HiddenInputField

[physics]
gravity_y = -1000.0
scale = 0.01

[html5]
scale_mode = stretch

[project]
title = defold-render-pipeline

[drp]
default_profile = balanced
fallback_profile = compatibility
strict_capabilities = 0

