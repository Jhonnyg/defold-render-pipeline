name: "drp_hdr_tonemap"
tags: "drp_hdr_tonemap"
vertex_program: "/drp/features/hdr/fullscreen.vp"
fragment_program: "/drp/features/hdr/tonemap.fp"
vertex_space: VERTEX_SPACE_LOCAL
fragment_constants { name: "hdr_settings" type: CONSTANT_TYPE_USER }
samplers {
  name: "texture0"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_LINEAR
  filter_mag: FILTER_MODE_MAG_LINEAR
}
