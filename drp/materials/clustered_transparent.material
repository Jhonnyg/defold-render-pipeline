name: "drp_clustered_transparent"
tags: "drp_cluster_transparent"
vertex_program: "/defold-pbr/shaders/pbr.vp"
fragment_program: "/drp/shaders/clustered_transparent.fp"
vertex_space: VERTEX_SPACE_LOCAL
vertex_constants { name: "mtx_worldview" type: CONSTANT_TYPE_WORLDVIEW }
vertex_constants { name: "mtx_view" type: CONSTANT_TYPE_VIEW }
vertex_constants { name: "mtx_proj" type: CONSTANT_TYPE_PROJECTION }
vertex_constants { name: "mtx_normal" type: CONSTANT_TYPE_NORMAL }
fragment_constants { name: "cluster_grid" type: CONSTANT_TYPE_USER value { x: 10.0 y: 7.0 z: 16.0 w: 64.0 } }
fragment_constants { name: "cluster_screen" type: CONSTANT_TYPE_USER value { x: 960.0 y: 640.0 z: 96.0 w: 0.010416667 } }
fragment_constants { name: "cluster_z_params" type: CONSTANT_TYPE_USER value { x: 0.1 y: 1000.0 } }
samplers { name: "PbrMetallicRoughness_baseColorTexture" wrap_u: WRAP_MODE_REPEAT wrap_v: WRAP_MODE_REPEAT filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
samplers { name: "PbrMetallicRoughness_metallicRoughnessTexture" wrap_u: WRAP_MODE_REPEAT wrap_v: WRAP_MODE_REPEAT filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
samplers { name: "PbrMaterial_normalTexture" wrap_u: WRAP_MODE_REPEAT wrap_v: WRAP_MODE_REPEAT filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
samplers { name: "PbrMaterial_occlusionTexture" wrap_u: WRAP_MODE_REPEAT wrap_v: WRAP_MODE_REPEAT filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
samplers { name: "PbrMaterial_emissiveTexture" wrap_u: WRAP_MODE_REPEAT wrap_v: WRAP_MODE_REPEAT filter_min: FILTER_MODE_MIN_LINEAR filter_mag: FILTER_MODE_MAG_LINEAR }
