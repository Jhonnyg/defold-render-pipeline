local pipeline = require("drp.internal.pipeline")

function init(self)
	local state, err = pipeline.initialize()
	if not state then
		error(err)
	end
end

function update(self, dt)
	local _, frame_error = pipeline.begin_frame(
		dt,
		render.get_window_width(),
		render.get_window_height()
	)
	if frame_error then
		error(frame_error)
	end

	local rendered, render_error = pipeline.render()
	if not rendered then
		error(render_error)
	end
end

-- Defold render scripts have no final() callback. Defining one here leaves a
-- global that can leak into game scripts in a shared Lua state. Runtime
-- teardown is explicit via pipeline.finalize() from a render-script callback.

function on_message(self, message_id, message, sender)
	pipeline.on_message(message_id, message, sender)
end

function on_reload(self)
	pipeline.reload()
end
