name: "clustered_renderer"
scale_along_z: 0
embedded_instances {
  id: "camera"
  data: "components {\n"
  "  id: \"vantage\"\n"
  "  component: \"/vantage/vantage_component.script\"\n"
  "  properties { id: \"first_person_movement_speed\" value: \"4.0\" type: PROPERTY_TYPE_NUMBER }\n"
  "}\n"
  "embedded_components {\n"
  "  id: \"camera\"\n"
  "  type: \"camera\"\n"
  "  data: \"aspect_ratio: 1.0\\nfov: 0.7854\\nnear_z: 0.1\\nfar_z: 100.0\\nauto_aspect_ratio: 1\\n\"\n"
  "}\n"
  ""
  position { y: 1.0 z: 4.0 }
}
